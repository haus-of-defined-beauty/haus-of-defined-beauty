PORT=5000
MONGO_URI=mongodb://localhost:27017/hodb
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gmail — email notifications (booking confirmations/reschedules)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: override where each email's branded header banner is loaded from.
# Defaults to <FRONTEND_URL>/email/header-{otp,booking,reminder}.jpg — only
# set these if the images ever need to live somewhere other than the
# frontend's own /public/email folder.
# EMAIL_HEADER_OTP_URL=
# EMAIL_HEADER_BOOKING_URL=
# EMAIL_HEADER_REMINDER_URL=

# PayFast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
FRONTEND_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:5000

# Shared secret the scheduled reminder job must send to prove it's really the
# reminder cron, not a public caller (see /api/reminders/send). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REMINDER_CRON_SECRET=
